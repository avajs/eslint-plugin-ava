{
	"name": "eslint-plugin-ava",
	"version": "17.0.1",
	"description": "ESLint rules for AVA",
	"license": "MIT",
	"repository": "avajs/eslint-plugin-ava",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"integration": "node ./test/integration/test.js",
		"lint": "npm-run-all \"lint:*\"",
		"lint:eslint-docs": "npm-run-all \"update:eslint-docs -- --check\"",
		"lint:js": "xo",
		"test": "npm-run-all lint test:unit",
		"test:unit": "c8 node --test 'test/*.js'",
		"update:eslint-docs": "eslint-doc-generator --rule-doc-section-include Examples --url-configs \"https://github.com/avajs/eslint-plugin-ava#recommended-config\""
	},
	"files": [
		"index.js",
		"index.d.ts",
		"create-ava-rule.js",
		"rules",
		"util.js"
	],
	"keywords": [
		"eslint",
		"eslintplugin",
		"eslint-plugin",
		"ava",
		"test",
		"runner",
		"assert",
		"asserts",
		"assertion",
		"mocha"
	],
	"dependencies": {
		"@eslint-community/eslint-utils": "^4.10.1",
		"@eslint/json": "^2.1.0",
		"espree": "^11.2.0",
		"espurify": "^3.2.0",
		"micro-spelling-correcter": "^1.1.1",
		"resolve-from": "^5.0.0"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8.71.1",
		"c8": "^12.0.0",
		"chalk": "^6.0.1",
		"eslint": "^10.12.0",
		"eslint-ava-rule-tester": "^5.0.1",
		"eslint-doc-generator": "^3.7.1",
		"eslint-plugin-eslint-plugin": "^7.6.2",
		"execa": "^10.0.1",
		"npm-run-all": "^4.1.5",
		"outdent": "^0.8.0",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"peerDependencies": {
		"eslint": ">=10"
	},
	"c8": {
		"reporter": [
			"html",
			"lcov",
			"text"
		]
	}
}
